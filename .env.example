# Compre Barato Alagoas — configuração única (app + deploy).
# Copie para `.env` e preencha. NUNCA versione um `.env` real (veja .gitignore).
# Este mesmo arquivo alimenta o backend local e o docker-compose de deploy.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Origens permitidas (CORS), separadas por vírgula. Em produção, use o domínio real.
CORS_ORIGINS=*

# --- Flags de mock ---
# Mantenha true até ter o token da SEFAZ / uma chave de LLM configurada.
USE_MOCK_SEFAZ=true
USE_MOCK_LLM=true

# --- API Economiza Alagoas / SEFAZ-AL (usado quando USE_MOCK_SEFAZ=false) ---
SEFAZ_BASE_URL=http://api.sefaz.al.gov.br/sfz-economiza-alagoas-api/api/public/
# Prefira definir o token pelo painel admin (Configurações): ele é criptografado no
# Redis e nunca fica em disco/git/logs. Deixe esta variável VAZIA em produção; ela é
# apenas um fallback de bootstrap usado quando o painel ainda não tem um token.
SEFAZ_APP_TOKEN=
SEFAZ_TIMEOUT_SECONDS=15

# --- LLM / Claude (usado quando USE_MOCK_LLM=false) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# --- Padrões de busca (dentro dos limites da SEFAZ) ---
DEFAULT_RADIUS_KM=8        # 1..15
DEFAULT_DAYS=7             # 1..10
RECORDS_PER_PAGE=500       # 50..5000
TOP_STORES=5
SEFAZ_CONCURRENCY=6        # itens buscados em paralelo (fan-out por busca)
MAX_SEFAZ_PAGES=1          # páginas por item (>1 segue totalPaginas da SEFAZ)

# --- Cache + armazenamento (Redis é OBRIGATÓRIO; a app não sobe sem ele) ---
# Guarda cache de busca, listas compartilháveis, registros de dispositivo e limites.
# Em docker-compose já vem como redis://redis:6379/0. Para dev local: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=21600

# --- Privacidade (LGPD) ---
# Versão da política/termos gravada em cada registro de consentimento.
POLICY_VERSION=2026-06-06

# --- Limite de uso ---
DAILY_SEARCH_LIMIT=300     # por cliente por dia; 0 desativa

# --- Painel admin (dashboard) ---
# Token Bearer que protege /admin/api/* (servido em admin.<domínio>).
# Vazio => API admin desativada (responde 401). Use um valor longo e aleatório.
ADMIN_TOKEN=

# --- Cofre de segredos (criptografia em repouso) ---
# Chave Fernet que criptografa segredos definidos pelo painel admin (ex.: token SEFAZ)
# antes de irem para o Redis. Gere uma vez com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Vazia => painel de segredos desativado (SEFAZ cai no fallback SEFAZ_APP_TOKEN).
# Guarde-a como segredo de ops (igual ao ADMIN_TOKEN); perdê-la apaga os segredos salvos.
SECRET_ENCRYPTION_KEY=

# --- Banco de dados (Postgres + pgvector; opcional, não exigido pelo fluxo principal) ---
# Em deploy com docker-compose, estes valores criam e conectam o Postgres.
DATABASE_URL=
POSTGRES_USER=alagoas
POSTGRES_PASSWORD=troque-em-producao
POSTGRES_DB=alagoas

# --- Observabilidade (opcional; vazio => desativado) ---
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
