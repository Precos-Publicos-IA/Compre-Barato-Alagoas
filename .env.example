# Compre Barato Alagoas — single configuration (app + deploy).
# Copy to `.env` and fill in. NEVER commit a real `.env` (see .gitignore).
# This same file feeds the local backend and the deploy docker-compose.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Allowed origins (CORS), comma-separated. In production, use the real domain.
# With a specific domain (not "*"), preflight only exposes used methods/headers.
CORS_ORIGINS=*
# Hosts (Host header) the app will answer, comma-separated. "*" disables the
# check (dev). In production, pin the real app/API hosts (misconfigured proxy).
ALLOWED_HOSTS=*
# Interactive OpenAPI UI (/docs, /redoc, /openapi.json). Empty = automatic:
# on outside production, off when ENVIRONMENT=production.
# Force with true/false if needed (e.g. one-off staging debug).
# EXPOSE_API_DOCS=

# --- Mock flags ---
# USE_MOCK_SEFAZ=true  → synthetic Maceió catalog (offline dev)
# USE_MOCK_SEFAZ=false → official SEFAZ JSON API (requires AppToken)
USE_MOCK_SEFAZ=true
USE_MOCK_LLM=true
# Legacy Economiza website scraper (debug only). Production: leave false.
# When false, there is no website fallback — official API only.
USE_WEB_SEFAZ=false

# --- Economiza Alagoas / SEFAZ-AL API (used when USE_MOCK_SEFAZ=false) ---
SEFAZ_BASE_URL=http://api.sefaz.al.gov.br/sfz-economiza-alagoas-api/api/public/
# AppToken options (never commit a real value), priority:
# 1) Admin panel Redis sefaz_token (highest when set)
# 2) SEFAZ_APP_TOKEN_FILE — bind-mounted raw file (fallback)
# 3) SEFAZ_APP_TOKEN env — production: from secrets/sefaz.env via Compose env_file
#
# Production: GitHub secret SEFAZ_APP_TOKEN → deploy writes secrets/sefaz.env
# (mode 600) + secrets/sefaz_app_token (mode 644 for non-root read). Leave this
# line empty in the shared .env.
# Required for live searches when USE_MOCK_SEFAZ=false and USE_WEB_SEFAZ=false.
SEFAZ_APP_TOKEN=
# SEFAZ_APP_TOKEN_FILE=/run/secrets/sefaz_app_token
SEFAZ_TIMEOUT_SECONDS=15
SEFAZ_ITEM_DEADLINE_SECONDS=55

# --- Legacy website scraper (only if USE_WEB_SEFAZ=true) ---
SEFAZ_WEB_BASE_URL=https://economizaalagoas.sefaz.al.gov.br
SEFAZ_WEB_TIMEOUT_SECONDS=45
SEFAZ_WEB_MAX_CARDS=200
SEFAZ_WEB_MAX_BYTES=1500000
SEFAZ_WEB_CONCURRENCY=2

# --- LLM / Claude (used when USE_MOCK_LLM=false) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# --- Search defaults (within SEFAZ limits) ---
DEFAULT_RADIUS_KM=8        # 1..15
DEFAULT_DAYS=7             # 1..10
RECORDS_PER_PAGE=500       # 50..5000
TOP_STORES=5
SEFAZ_CONCURRENCY=3        # items fetched in parallel (lower when using website)
MAX_SEFAZ_PAGES=1          # pages per item (>1 follows SEFAZ totalPaginas)

# --- Cache + storage (Redis is REQUIRED; the app will not start without it) ---
# Holds search cache, shareable lists, device records, and rate limits.
# In docker-compose it comes as redis://redis:6379/0. For local dev: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=21600

# --- Privacy (LGPD) ---
# Policy/terms version stored on each consent record.
POLICY_VERSION=2026-06-06

# --- Usage limit ---
DAILY_SEARCH_LIMIT=300     # per client per day; 0 disables
# Salt used in the IP hash that becomes the rate-limit key (IP is never stored raw).
# In production, set a private random value (a fixed/known salt weakens
# anonymization if Redis leaks). Generate with: openssl rand -hex 24
# RATELIMIT_SALT=replace-with-a-private-value
# Lab/ops IPs (or CIDRs) that skip the daily search limit — for match-eval / agent
# tooling against production. Comma-separated. Set only on the server .env (never
# commit real egress IPs). Example shape: RATELIMIT_WHITELIST_IPS=203.0.113.50
# Non-production environments also skip loopback + RFC1918 automatically.
RATELIMIT_WHITELIST_IPS=

# --- Admin panel (dashboard) ---
# Bearer token that protects /admin/api/* (served at admin.<domain>).
# Empty => admin API disabled (returns 401). Use a long random value.
ADMIN_TOKEN=

# --- Secrets vault (encryption at rest) ---
# Fernet key that encrypts secrets set from the admin panel (e.g. SEFAZ token)
# before they go to Redis. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty => secrets panel disabled (SEFAZ falls back to SEFAZ_APP_TOKEN).
# Treat it as an ops secret (like ADMIN_TOKEN); losing it wipes saved secrets.
SECRET_ENCRYPTION_KEY=

# --- Database (Postgres + pgvector; optional, not required by the main flow) ---
# In docker-compose deploy, these values create and connect Postgres.
DATABASE_URL=
POSTGRES_USER=alagoas
POSTGRES_PASSWORD=change-in-production
POSTGRES_DB=alagoas

# --- Observability (optional; empty => disabled) ---
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
