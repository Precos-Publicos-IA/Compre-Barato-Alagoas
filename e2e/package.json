{
  "name": "compre-barato-alagoas-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Headless browser tests (inputs + screenshots) for all Compre Barato Alagoas surfaces.",
  "scripts": {
    "smoke": "node smoke.js",
    "full": "node full.js",
    "full:local": "bash run_local.sh",
    "live": "node live.js",
    "admin_smoke": "node admin_smoke.js",
    "matrix": "node matrix_capture.js",
    "matrix:local": "bash run_matrix_local.sh",
    "matrix:verify": "VERIFY_ONLY=1 MATRIX_FORMATS=all MATRIX_SCREENS=all node matrix_capture.js",
    "matrix:priority": "MATRIX_FORMATS=priority MATRIX_SCREENS=priority bash run_matrix_local.sh",
    "matrix:desktop": "MATRIX_FORMATS=desktop bash run_matrix_local.sh",
    "matrix:handheld": "MATRIX_FORMATS=handheld bash run_matrix_local.sh",
    "matrix:emulator": "node matrix_emulator.js",
    "matrix:full": "RUN_EMULATOR=1 bash run_matrix_local.sh"
  },
  "dependencies": {
    "puppeteer": "^21.11.0"
  }
}
